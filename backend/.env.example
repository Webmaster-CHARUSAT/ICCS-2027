NODE_ENV=development
PORT=8080

# Origins the API accepts cross-origin requests from (exact match; production only — outside
# production any loopback origin is also accepted, see server.js). In production this MUST be
# your real deployed URL(s), not localhost — see config.js's production validation, which
# refuses to boot otherwise.
FRONTEND_URL=http://localhost:5500
ADMIN_URL=http://localhost:5500

# How many reverse-proxy hops to trust for X-Forwarded-* headers (only applied when
# NODE_ENV=production). 1 is correct for Render, Railway, and most single-proxy PaaS setups.
TRUST_PROXY=1

# Google Sheets access via a Google Apps Script Web App bound to the spreadsheet
# (see google-apps-script/Code.gs and README.md "Google Sheets Setup").
# APPS_SCRIPT_URL is the deployment's /exec URL. APPS_SCRIPT_SECRET must be the exact same
# random string you set as the SHARED_SECRET Script Property in the Apps Script project
# (Project Settings -> Script Properties — NOT a hardcoded constant in Code.gs).
APPS_SCRIPT_URL=
APPS_SCRIPT_SECRET=
# How long to wait for the Apps Script Web App before giving up (it can be slow on a cold
# start). Optional — defaults to 15000 (15s) if unset.
APPS_SCRIPT_TIMEOUT_MS=15000

# Outgoing mail for registration/abstract confirmations, via any standard SMTP provider.
# Example for Gmail: host smtp.gmail.com, port 587, secure false, user your address,
# pass a 16-character Google Account "App Password" (not your normal password — requires
# 2-Step Verification enabled: https://myaccount.google.com/apppasswords). Spaces in a
# pasted App Password are stripped automatically, but paste the full 16 characters.
# If left blank, confirmation emails are skipped (logged as a warning) — submissions still work.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=ICCS-CIRCLE 2027 <no-reply@iccs-circle.org>
